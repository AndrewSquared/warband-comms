<Interface xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../Interface.xsd">
    <Windows>
        <Window name="WarbandCommsConfig" inherits="EA_Window_Default" movable="true">
            <Size>
                <AbsPoint x="400" y="250" />
            </Size>
            <Anchors>
                <Anchor point="center" relativePoint="center">
                    <AbsPoint x="0" y="0"/>
                </Anchor>
            </Anchors>
            <Windows>
                <!-- Config Background -->
                <Window name="$parentBackground" inherits="EA_Window_DefaultBackgroundFrame" />

                <!-- Title Bar -->
                <Window name="$parentTitleBar" inherits="EA_TitleBar_Default" />

                <!--Close Button-->
                <Button name="$parentTopRightCloseButton" inherits="EA_Button_DefaultWindowClose">
					<EventHandlers>
						<EventHandler event="OnLButtonUp" function="WarbandComms.OnClose" />
					</EventHandlers>
				</Button>

                <!--Info-->
                <Label name="$parentInfoLabel" font="font_clear_medium_bold" textalign="center">
                    <Size><AbsPoint x="700" y="20"/></Size>
                    <Anchors>
                        <Anchor point="bottomleft" relativePoint="bottomleft">
                            <AbsPoint x="0" y="-25"/>
                        </Anchor>
                    </Anchors>
                    <Text>info..</Text>
                </Label>

                <!-- Trackers Title -->
                <Label name="$parentTrackerTitle" font="font_clear_medium_bold" textalign="left">
                    <Size><AbsPoint x="350" y="20" /></Size>
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
                            <AbsPoint x="50" y="50" />
                        </Anchor>
                    </Anchors>
                </Label>
                <Button name="$parentEnableTrackersButton" inherits="EA_Button_DefaultCheckBox">
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft">
                            <AbsPoint x="20" y="50"/>
                        </Anchor>
                    </Anchors>
                    <EventHandlers>
                        <EventHandler event="OnLButtonUp" function="WarbandComms.ToggleAllTrackers" />
                    </EventHandlers>
                </Button>

                <!-- dynamically generated tracker checkbox and labels -->

                <!-- Notifications Title -->
                <Label name="$parentNotificationsTitle" font="font_clear_medium_bold" textalign="left">
                    <Size><AbsPoint x="350" y="20" /></Size>
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
                            <AbsPoint x="350" y="50" />
                        </Anchor>
                    </Anchors>
                </Label>

                <!-- dynamically generated notification checkbox and labels -->

            </Windows>
        </Window>
    </Windows>
</Interface>
